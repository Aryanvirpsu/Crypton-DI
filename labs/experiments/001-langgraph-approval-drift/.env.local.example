# Copy to .env.local (gitignored — never commit real keys) and fill in.
# Only needed to run #001e (run_experiment_llm.py) — #001/#001b/#001c/#001d
# are fully deterministic and need no API key at all.

# Used by target_agent_llm.py via langchain-openai. This is the key
# #001e's batches actually ran against (see finding-001e.md).
OPENAI_API_KEY=

# Only needed if you switch target_agent_llm.py back to Gemini. Note
# (see finding-001e.md / target_agent_llm.py's module docstring): the
# newest Gemini models use fixed sampling (temperature ignored) as of
# this session, and the free tier caps at 20 requests/day/model — both
# documented in finding-001e.md as the reason #001e's batches use OpenAI
# instead.
GOOGLE_API_KEY=
