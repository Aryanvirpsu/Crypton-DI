# Crypton Agent Lab — environment (copy to .env, fill in, never commit)

# crypton-id's PUBLIC key (services/crypton-id/.env / dev.env's
# JWT_PUBLIC_KEY_PEM_FILE — copy that file's contents in). Asymmetric
# (Ed25519/EdDSA) since v0.5.1 — see DECISIONS.md. Agent Lab verifies the
# exact same JWTs crypton-id issues; it never holds crypton-id's private
# signing key, and this module has no way to mint anything with just this
# value. Not a second identity system; see src/agentlab/identity.py.
# Only needed for `--token <a real crypton-id JWT>` — `--dev-user` needs
# nothing here (see identity.generate_dev_keypair).
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\npaste_crypton_ids_public_key_here\n-----END PUBLIC KEY-----\n"

# The one supported model provider for v0.1 (src/agentlab/model_provider.py).
# Never commit a real key. Omit both and run the CLI with --fake to exercise
# the full loop without any LLM credentials.
ANTHROPIC_API_KEY=
AGENT_LAB_MODEL=claude-sonnet-5
