# Crypton Agent Lab v0.1 — environment (copy to .env, fill in, never commit)

# Shared with crypton-id (services/crypton-id/.env / dev.env) — Agent Lab
# verifies the exact same JWTs crypton-id issues, using the same secret.
# Not a second identity system; see src/agentlab/identity.py.
JWT_SECRET=change_me_to_a_long_random_secret

# The one supported model provider for v0.1 (src/agentlab/model_provider.py).
# Never commit a real key. Omit both and run the CLI with --fake to exercise
# the full loop without any LLM credentials.
ANTHROPIC_API_KEY=
AGENT_LAB_MODEL=claude-sonnet-5
