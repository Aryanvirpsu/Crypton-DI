{
  "name": "crypton-console",
  "version": "1.0.0",
  "private": true,
  "description": "Crypton product console — register/login, devices, recovery, and admin surfaces. The one functional frontend (replaces the former crypton-demo + crypton-admin split).",
  "proxy": "http://127.0.0.1:8090",
  "scripts": {
    "start": "react-scripts start",
    "build:sdk": "npm --prefix ../../libs/crypton-sdk install && npm --prefix ../../libs/crypton-sdk run build",
    "build": "npm run build:sdk && react-scripts build",
    "test": "react-scripts test"
  },
  "dependencies": {
    "@crypton/sdk": "file:../../libs/crypton-sdk",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "eslintConfig": {
    "extends": ["react-app", "react-app/jest"]
  },
  "browserslist": {
    "production": [">0.2%", "not dead", "not op_mini all"],
    "development": ["last 1 chrome version", "last 1 firefox version", "last 1 safari version"]
  },
  "engines": {
    "node": ">=18"
  }
}
