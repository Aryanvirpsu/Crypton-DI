# crypton-console environment — copy to .env (or .env.local) and adjust.

# Base URL for API calls. Leave empty in local dev — the CRA dev server
# proxies same-origin requests to the gateway (see "proxy" in package.json).
REACT_APP_API_BASE=

# Marketing site link (sidebar "Back to Home", breadcrumb).
REACT_APP_MAIN_URL=http://localhost:3000
