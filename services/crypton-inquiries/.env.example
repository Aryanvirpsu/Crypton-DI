# Keep secrets out of REACT_APP_* variables. Copy this to .env.local locally.
# Development generates an ignored local key automatically. Production requires all three.
INQUIRY_ORIGIN=http://localhost:3000
INQUIRY_DB=.private/inquiries.sqlite
# INQUIRY_KEY=<64 hex characters; generate securely, back up separately from the database>
PORT=8091
HOST=127.0.0.1
# Optional: serve the production frontend build from the same process/origin.
# INQUIRY_BUILD_DIR=../crypton-main/build
# Only configure when your immediate reverse proxy strips/appends X-Forwarded-For.
# INQUIRY_TRUSTED_PROXY=127.0.0.1
