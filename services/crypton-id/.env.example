# crypton-identity environment — copy to .env and fill in values
# .env is gitignored; this file is the committed template.

APP_PORT=8080

# Postgres (docker-compose spins one up at localhost:5432)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crypton

# Redis (docker-compose spins one up at localhost:6379)
REDIS_URL=redis://127.0.0.1:6379

RUST_LOG=info

# Set to "json" for structured (machine-parseable) logs. Leave unset for
# human-readable text (the default).
# LOG_FORMAT=json

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# WEBAUTHN_RP_ID must be a registrable domain suffix of WEBAUTHN_ORIGIN.
# The origin seen by the browser must match WEBAUTHN_ORIGIN exactly.
#
# ── Option A: Local dev with TLS (crypton.local) ─────────────────────────────
# Requires:
#   1. Hosts file entry:  127.0.0.1  crypton.local
#   2. Self-signed cert:  crypton.local.pem / crypton.local-key.pem in this dir
#      Generate with mkcert:  mkcert crypton.local
# The server serves the test UI at https://crypton.local:8080/test
#
# WEBAUTHN_RP_ID=crypton.local
# WEBAUTHN_ORIGIN=https://crypton.local:8080

# ── Option B: Cloudflare quick-tunnel (eduroam / cross-device) ───────────────
# Run ./dev-tunnel.ps1 to get a URL, then fill in the subdomain below.
# Restart the Rust server after changing these values.
# Test UI will be at https://<subdomain>.trycloudflare.com/test
#
# WEBAUTHN_RP_ID=<subdomain>.trycloudflare.com
# WEBAUTHN_ORIGIN=https://<subdomain>.trycloudflare.com

# ── Option C: Plain localhost (single-device only) ────────────────────────────
# Works because browsers treat localhost as a secure context.
# WebAuthn RP ID must be "localhost" for this to work.
#
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_ORIGIN=http://localhost:8080

# Uncomment exactly one block above, then set these:
WEBAUTHN_RP_ID=crypton.local
WEBAUTHN_ORIGIN=https://crypton.local:8080
WEBAUTHN_RP_NAME=Crypton Identity

# JWT — asymmetric (Ed25519/EdDSA) since v0.5.1. crypton-id holds the
# private key (JWT_SIGNING_KEY_PEM); every verifier (Agent Lab, a future
# gateway PEP, anything else) only ever needs JWT_PUBLIC_KEY_PEM — see
# DECISIONS.md "JWT: asymmetric signing replaces the shared HS256 secret".
# Never commit real values: for local dev, start.sh / run.bat generate a
# fresh keypair into the gitignored .env.local on first run instead of
# needing this filled in. To generate your own pair:
#   openssl genpkey -algorithm ed25519 -out jwt_signing_key.pem
#   openssl pkey -in jwt_signing_key.pem -pubout -out jwt_public_key.pem
# Then paste each PEM's contents below with real newlines replaced by \n
# and the whole value double-quoted (dotenvy interprets \n inside quotes).
JWT_SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\nchange_me_generate_your_own_key\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nchange_me_generate_your_own_key\n-----END PUBLIC KEY-----\n"

# ── OAuth (experimental) ──────────────────────────────────────────────────────
# The OAuth authorization-code routes (routes/oauth.rs) are incomplete
# (no PKCE, single hardcoded client) and are not mounted unless you opt in.
ENABLE_OAUTH=false
# Required only if ENABLE_OAUTH=true:
# OAUTH_CLIENT_ID=demo-site
# OAUTH_CLIENT_SECRET=<random-secret, required, no insecure default>
# OAUTH_REDIRECT_URIS=http://localhost:4000/callback
# FRONTEND_ORIGIN=http://localhost:3000

# ── Gateway integration ───────────────────────────────────────────────────────
# Bind address. Containers keep the default 0.0.0.0 (isolation comes from the private
# network); bare-metal/dev runs should set 127.0.0.1.
# BIND_ADDR=127.0.0.1
# Same value as the gateway GATEWAY_SHARED_SECRET. When set, identity refuses every
# request except /health that lacks the matching x-gateway-secret header.
# GATEWAY_SHARED_SECRET=
