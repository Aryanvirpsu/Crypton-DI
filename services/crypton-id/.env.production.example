# crypton-identity — PRODUCTION environment template
# Copy to: services/crypton-identity/.env  (never commit the filled copy)
#
# Production = main branch, stable domain or Cloudflare tunnel.
# Passkeys enrolled on a given RP_ID are permanently bound to it —
# changing WEBAUTHN_RP_ID invalidates all existing registered devices.

APP_PORT=8080
# Use a dedicated role with a strong generated password; the dev default
# (postgres:postgres) must never reach production.
DATABASE_URL=postgres://<user>:<password_CHANGE_THIS>@<private-host>:5432/crypton
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=warn

# ── Gateway integration (defence in depth) ────────────────────────────────────
# Identity must not be reachable except through crypton-gateway (private networking).
# Set the SAME random value (>= 16 chars) on the gateway; identity then refuses every
# request except /health that lacks the matching x-gateway-secret header, and
# REQUIRE_GATEWAY_SECRET makes it refuse to start without the secret.
# See docs/deployment-topology.md.
GATEWAY_SHARED_SECRET=<random_secret_CHANGE_THIS>
REQUIRE_GATEWAY_SECRET=true

# ── WebAuthn ──────────────────────────────────────────────────────────────────
# CRITICAL: never change these after users have enrolled passkeys.
WEBAUTHN_RP_NAME=Crypton Identity
WEBAUTHN_RP_ID=<your-stable-domain.com>
WEBAUTHN_ORIGIN=https://<your-stable-domain.com>

# ── JWT (asymmetric, Ed25519/EdDSA — see DECISIONS.md) ────────────────────────
# Must differ from staging. Generate a fresh pair — never reuse staging's:
#   openssl genpkey -algorithm ed25519 -out jwt_signing_key.pem
#   openssl pkey -in jwt_signing_key.pem -pubout -out jwt_public_key.pem
# Only crypton-id needs JWT_SIGNING_KEY_PEM (the private key). Any verifier
# (a future gateway PEP, Agent Lab, etc.) is handed JWT_PUBLIC_KEY_PEM only.
JWT_SIGNING_KEY_PEM=<production_ed25519_private_key_pem_CHANGE_THIS>
JWT_PUBLIC_KEY_PEM=<production_ed25519_public_key_pem_CHANGE_THIS>

# ── OAuth ─────────────────────────────────────────────────────────────────────
OAUTH_CLIENT_ID=demo-site
OAUTH_CLIENT_SECRET=<production_oauth_secret_CHANGE_THIS>
OAUTH_REDIRECT_URIS=https://<your-stable-domain.com>/callback
FRONTEND_ORIGIN=https://<your-stable-domain.com>
