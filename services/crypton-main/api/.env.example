# Assessment API: server-side only. Copy to api/.env.local for local development (gitignored).
# In Vercel, set these in Project Settings -> Environment Variables and mark the secrets Sensitive.
# NEVER prefix any of these with REACT_APP_: that would put them in the browser bundle.

# 64 hex characters. Generate:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing this key makes stored leads permanently unreadable. Keep a copy in a password manager.
ASSESSMENT_MASTER_KEY=

# Least-privilege `assessment_writer` role through the Supabase pooler (transaction mode).
# Local development against a throwaway Postgres: postgres://assessment_writer:<pw>@127.0.0.1:5432/<db>
ASSESSMENT_DATABASE_URL=

# Exact origins allowed to call the API, comma separated.
ASSESSMENT_ALLOWED_ORIGINS=http://localhost:3000

# verify (default) | require | disable. `disable` is accepted only for localhost outside production.
# ASSESSMENT_DATABASE_SSL=verify
# PEM certificate authority for `verify`, with \n for newlines (Supabase publishes its CA in the dashboard).
# ASSESSMENT_DATABASE_CA=

# --- Operator tool only (npm run inbox). Keep on your own machine, not in Vercel. ---
# `assessment_operator` role, direct (non-pooled) connection.
# ASSESSMENT_OPERATOR_DATABASE_URL=
# After a key rotation, the old key so earlier leads still decrypt.
# ASSESSMENT_MASTER_KEY_PREVIOUS=

# --- Tests only ---
# Superuser URL of a throwaway Postgres >= 15. Each run creates and drops its own database.
# ASSESSMENT_TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
