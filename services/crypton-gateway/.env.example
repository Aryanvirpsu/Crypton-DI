# crypton-gateway environment configuration
# Copy to .env and adjust as needed.

# Port the gateway listens on (PORT takes precedence if both are set —
# Railway and similar platforms inject PORT).
APP_PORT=8090

# URL of the crypton-identity service that the gateway proxies to.
IDENTITY_URL=http://127.0.0.1:8080

# Comma-separated CORS allowlist. Defaults to local dev origins if unset.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Log level: error | warn | info | debug | trace
RUST_LOG=info

# Set to "json" for structured (machine-parseable) logs. Leave unset for
# human-readable text (the default).
# LOG_FORMAT=json
