# crypton-gateway environment configuration
# Copy to .env and adjust as needed. Do not commit real values.

# External listener port (Railway sets PORT; APP_PORT is the fallback). Default 8090.
PORT=8090
# Internal listener (metrics, diagnostics, audit ingest) - bound to 127.0.0.1 only. Default 9090.
INTERNAL_PORT=9090

# URL of the crypton-identity service that the gateway proxies to.
# Identity must not be reachable by clients except through the gateway.
IDENTITY_URL=http://127.0.0.1:8080

# REQUIRED. Postgres: the SAME database crypton-id uses (credentials, users, audit_logs).
DATABASE_URL=postgres://user:password@localhost/crypton
# Redis shared with crypton-id (revocation denylist, nonces, rate limits, risk counters).
REDIS_URL=redis://127.0.0.1:6379

# REQUIRED. The PUBLIC half of crypton-id's Ed25519 signing key (SPKI PEM), the same
# value crypton-id's JWT_PUBLIC_KEY_PEM(_FILE) uses. The gateway never needs the private key.
# Either a path:
JWT_PUBLIC_KEY_PEM_FILE=./jwt_public_key.local.pem
# or the PEM inline (newline-escaped inside double quotes):
# JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----\n"

# REQUIRED. Shared token for service-to-service calls to /internal/audit/ingest.
INTERNAL_TOKEN=

# Shared secret added as x-gateway-secret to every request forwarded to identity.
# Set the SAME value as GATEWAY_SHARED_SECRET in crypton-id, which then refuses any
# request (except /health) that did not come through the gateway. Defence in depth
# only: identity must still be reachable solely over a private network.
GATEWAY_SHARED_SECRET=
# Production-intended deployments: refuse to start unless the secret is set (>= 16 chars).
# REQUIRE_GATEWAY_SECRET=true

# true (default): risk-engine Deny/Challenge/Hold actually block. false: dry-run, log only.
POLICY_ENFORCE=true

# Log level (error|warn|info|debug|trace) and format (text default, or json).
RUST_LOG=info
LOG_FORMAT=text
