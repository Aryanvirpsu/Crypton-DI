# crypton dev environment -- example (copy to dev.env and fill in)
# Used by start-all.ps1 to populate environment variables for crypton-id.

# crypton-id identity backend
APP_PORT=8080
# Dev runs bind identity to loopback so it cannot be reached around the gateway.
BIND_ADDR=127.0.0.1
# Shared secret the gateway adds to forwarded requests; identity refuses requests
# without it (except /health). Set the SAME value in the gateway environment.
# GATEWAY_SHARED_SECRET=
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/crypton
REDIS_URL=redis://127.0.0.1:6379
RUST_LOG=info
# JWT — asymmetric (Ed25519/EdDSA) since v0.5.1, see DECISIONS.md. Not set
# here: start-all.ps1 generates a local dev keypair (jwt_signing_key.local.pem
# / jwt_public_key.local.pem, both gitignored) on first run and points
# JWT_SIGNING_KEY_PEM_FILE / JWT_PUBLIC_KEY_PEM_FILE at them automatically —
# multi-line PEM content doesn't fit cleanly in this file's single-line
# KEY=VALUE format. To generate your own pair manually:
#   openssl genpkey -algorithm ed25519 -out jwt_signing_key.local.pem
#   openssl pkey -in jwt_signing_key.local.pem -pubout -out jwt_public_key.local.pem

# WebAuthn (localhost dev defaults -- change for tunnel/production)
# For cloudflared tunnel: set RP_ID and ORIGIN to your tunnel hostname
WEBAUTHN_RP_NAME=Crypton Identity
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3001

# OAuth is experimental and unmounted by default — see
# services/crypton-id/src/routes/oauth.rs. Leave ENABLE_OAUTH=false unless
# you specifically need it; the routes below only matter if it's true.
ENABLE_OAUTH=false
OAUTH_CLIENT_ID=demo-site
OAUTH_CLIENT_SECRET=<change-in-prod>
OAUTH_REDIRECT_URIS=http://localhost:4000/callback
FRONTEND_ORIGIN=http://localhost:3001

# crypton-gateway
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
